# syntax=docker/dockerfile:1.4
#
# The zaino CI build environment: a Rust toolchain image (protoc, RocksDB,
# cargo-nextest) used as the `container:` for the GitHub Actions jobs. It ships
# **no** validator binaries — the live-test suites get their validators from the
# ztest Kubernetes harness, not from this image. See docs/testing.md.

ARG UID=1000
ARG GID=${UID}
ARG USER=container_user
ARG HOME="/home/container_user"
ARG CARGO_HOME="/usr/local/cargo"

FROM docker.io/library/rust:1.96.0-trixie AS base

ARG UID
ARG GID
ARG USER
ARG HOME
ARG CARGO_HOME

ENV CARGO_HOME=${CARGO_HOME}
ENV CARGO_TERM_COLOR=always
ENV PATH="${CARGO_HOME}/bin:${PATH}"
ENV PROTOC=/usr/bin/protoc
ENV ROCKSDB_LIB_DIR=/usr/lib/x86_64-linux-gnu

LABEL maintainer="nachog00"
LABEL org.zaino.test-artifacts.versions.rust="1.96.0"

# Versions pinned (DL3008) to the candidates in rust:1.96.0-trixie; bump
# together with the base image (query with `apt-cache policy <pkg>`).
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl=8.14.1-2+deb13u4 \
    libclang-dev=1:19.0-63 \
    build-essential=12.12 \
    cmake=3.31.6-2 \
    librocksdb-dev=9.10.0-1+b1 \
    protobuf-compiler=3.21.12-11+deb13u1 \
    && rm -rf /var/lib/apt/lists/*

# Create container_user. The GID may already belong to a base-image group
# (e.g. on macOS hosts the caller's primary group is `staff`, GID 20, which
# collides with Debian's `dialout`); `--non-unique` lets the `container_user`
# group share that GID so later name-based ownership still resolves.
RUN groupadd --non-unique --gid ${GID} ${USER} && \
    useradd --uid ${UID} --gid ${GID} --home-dir ${HOME} --create-home ${USER}

# Toolchain baked in under the exact name + components rust-toolchain.toml asks for
#
# - absent → rustup fetches at every container start (nothing persists across runs)
# - version must track rust-toolchain.toml's `channel` by hand (root CLAUDE.md)
RUN rustup toolchain install 1.96.0 --profile minimal \
        --component rustfmt --component clippy && \
    rustup default 1.96.0

RUN mkdir -p ${CARGO_HOME} && \
    chown -R ${UID}:${GID} ${HOME} ${CARGO_HOME}

USER ${USER}

# cargo-nextest is the workspace test runner CI drives (`cargo nextest
# archive`/`run`), installed as container_user into the user-writable CARGO_HOME.
RUN cargo install cargo-nextest --locked --root "${CARGO_HOME}"

WORKDIR ${HOME}/zaino
