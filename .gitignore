/target
# Cargo build output in every (sub-)workspace, including nested ones such as
# live-tests/e2e/target — the anchored rules below only match
# specific paths and miss new sub-workspaces.
target/
/db
/docs/cargo_docs/debug
/.helix
/live-tests/Cargo.lock
/live-tests/e2e/Cargo.lock
/live-tests/chain_cache/*
/live-tests/test_binaries/bins/*
/live-tests/target/*
!/live-tests/chain_cache/testnet_get_subtree_roots_sapling
!/live-tests/chain_cache/testnet_get_subtree_roots_orchard
.cargo
.local/
build/
.failed-tests
**/proptest-regressions/**
/result
